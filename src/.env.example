# LLM
EMAIL_AI_LLM_PROVIDER=openai
EMAIL_AI_OPENAI_API_KEY=sk-your-key
EMAIL_AI_OPENAI_BASE_URL=http://xxxxxx
EMAIL_AI_LLM_MODEL=gpt-4o-mini
EMAIL_AI_LLM_TIMEOUT_SECONDS=30
EMAIL_AI_LLM_TEMPERATURE=0
EMAIL_AI_LLM_MAX_RETRIES=0

# Scoring weights
EMAIL_AI_PHISHING_WEIGHT=0.35
EMAIL_AI_ATTACHMENT_WEIGHT=0.25
EMAIL_AI_BEC_WEIGHT=0.25
EMAIL_AI_SPAM_WEIGHT=0.15

# Threat thresholds
EMAIL_AI_TRUSTED_THRESHOLD=10
EMAIL_AI_LOW_THRESHOLD=30
EMAIL_AI_MEDIUM_THRESHOLD=60
EMAIL_AI_HIGH_THRESHOLD=85

# Runtime
EMAIL_AI_LOG_LEVEL=INFO
EMAIL_AI_FEEDBACK_DB_PATH=data/feedback.sqlite3

# Observability extension points
EMAIL_AI_ENABLE_LANGSMITH=false
EMAIL_AI_ENABLE_LANGFUSE=false
